# Build output. Everything under a build/ directory is produced by a generator
# or a compiler -- hxcpp C++, object files, static libraries, the compiled
# binaries, and the Xcode/WinUI/Gradle projects the backends emit. None of it is
# written by hand, and all of it is reproduced by running the example's build.
#
# It had been tracked: 1492 files, 213 MB, against 105 files of actual source.
build/
bin/
bin-tests/

# `aui` emits its Android project beside the build.hxml that asked for it,
# not under build/ -- so building examples/build-aui.hxml drops an
# examples/android/ into the tree. Generated, like everything above.
android/

# `wui` does the same with its WinUI project: examples/build-wui.hxml drops
# an examples/winui/ beside itself. 3200 lines of generated C++.
winui/

# Haxe / hxcpp
*.n
*.jar
*.hash
haxe_libraries/
.haxelib/

# macOS
.DS_Store
