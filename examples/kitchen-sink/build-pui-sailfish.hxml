# Generate C++ only; the Sailfish .pro compiles it alongside Qt.
-cp src
-cp ../../src
-cp ../../../pui/src
-lib rui
-lib nui
-lib hxcpp
-D mui_backend=pui
-D pui_surface=qt
-D no-compilation
-D static_link
--macro rui.macros.ViewRule.register("mui.App", "body")
--macro mui.macros.Bind.all()
--main KitchenSink
-cpp ../../../pui/packaging/sailfish/generated
