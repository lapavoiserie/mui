# Regenerated from aui's src/aui/mui/init.hxml -- the backend states
# what its build needs. Only two things differ here: mui comes from this
# repository's source rather than -lib mui, and the example states its main.

-cp .
-cp ../../src
-lib aui
-D mui_backend=aui
-D jvm
--jvm build/app-logic.jar
--macro aui.macros.ComposeGenerator.register()
--macro mui.macros.Bind.all()
--macro aui.kui.Platform.registerWithKui()
--main TodoApp
