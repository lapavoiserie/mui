# Regenerated from cui's src/cui/mui/init.hxml -- the backend states
# what its build needs. Only two things differ here: mui comes from this
# repository's source rather than -lib mui, and the example states its main.

-cp .
-cp ../../src
-lib cui
-lib kui
-lib rui
-lib nui
-D mui_backend=cui
--macro mui.macros.Bind.all()
--macro cui.kui.Platform.registerWithKui()
--main SettingsApp
-cpp build/cui
