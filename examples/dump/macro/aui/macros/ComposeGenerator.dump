	static function extractDefaultValue(expr:haxe.macro.TypedExpr) {
		if (expr == null) {
			return null;
		};
		@:ast(switch (expr.expr) {
	case TConst(c):
		switch (c) {
			case TInt(i):
				return Std.string(i);			
