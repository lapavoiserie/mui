			var ` = 0;
			var ` = aui.macros.ComposeGenerator._appCandidates;
			while (` < `.length) {
				var candidate = `[`];
				++ `;
				if (candidate.parent != null) {
					{
						var key = candidate.parent;
						extended.set(key, true);
					};
				};
			};
		};
		{
			var ` = 0;
			var ` = aui.macros.ComposeGenerator._appCandidates;
			while (` < `.length) {
				var candidate = `[`];
				++ `;
				if (! {
					var key = candidate.name;
					extended.exists(key);
				}) {
					aui.macros.ComposeGenerator._appClass = candidate.name;
					aui.macros.ComposeGenerator._appModule = candidate.module;
					return;
				};
			};
		};
		aui.macros.ComposeGenerator._appClass = aui.macros.ComposeGenerator._appCandidates[0].name;
		aui.macros.ComposeGenerator._appModule = aui.macros.ComposeGenerator._appCandidates[0].module;
		haxe.macro.Context.warning("[AUI] several application classes found; building " + aui.macros.ComposeGenerator._appClass, haxe.macro.Context.currentPos(), null);
	}

	static function generateComposeFiles() {
		aui.macros.ComposeGenerator.ensureDir(aui.macros.ComposeGenerator._outputDir);
		var appType = haxe.macro.Context.getType(aui.macros.ComposeGenerator._appClass);
		var appName = "HaxeApp";
		var packageName = "com.haxe.app";
		var minSdk = 24;
		var targetSdk = 35;
		var compileSdk = 35;
		var androidConfig = null;
		if (sys.FileSystem.exists("aui.json")) {
			try {
				var json = {
					var text = sys.io.File.getContent("aui.json");
					new haxe.format.JsonParser(text).doParse();
				};
				if (json.appName != null) {
					appName = json.appName;
				};
				if (json.packageName != null) {
					packageName = json.packageName;
				};
				if (json.minSdk != null) {
					minSdk = json.minSdk;
				};
				if (json.targetSdk != null) {
					targetSdk = json.targetSdk;
				};
				if (json.compileSdk != null) {
					compileSdk = json.compileSdk;
				};
				if (json.android != null) {
					androidConfig = json.android;
				};
			} catch (`:Dynamic) {
				{};
				{};
				if (true) {
					{};
					{};
				} else throw `;
			};
		};
		aui.macros.ComposeGenerator._stateFields = aui.macros.ComposeGenerator.collectStateFields(appType);
		var firstGenerate = ! sys.FileSystem.exists("android/build.gradle.kts");
		var declaresGlance = aui.macros.ComposeGenerator.declaresGlanceSurface(appType);
		aui.macros.GradleProject.generate({appName : appName, packageName : packageName, minSdk : minSdk, targetSdk : targetSdk, compileSdk : compileSdk, android : androidConfig, glanceWidget : cast declaresGlance});
		if (firstGenerate) {
			haxe.macro.Context.warning("[AUI] Generated Android project in android/", haxe.macro.Context.currentPos(), null);
		};
		aui.macros.ComposeGenerator.generateMainActivity(packageName, appName);
		if (declaresGlance) {
			haxe.macro.Context.getType("aui.mui.GlanceBridge");
			aui.macros.ComposeGenerator.generateGlanceWidget(packageName, aui.macros.ComposeGenerator.appJvmName());
		};
		var screen = aui.macros.ComposeGenerator._outputDir + "/MainScreen.kt";
		if (aui.macros.RenderPath.isStatic()) {
			aui.macros.ComposeGenerator.generateMainScreen(packageName, appType);
		} else {
			if (sys.FileSystem.exists(screen)) {
				sys.FileSystem.deleteFile(screen);
			};
		};
		aui.macros.ComposeGenerator.writeAuiRuntimeKotlin();
		if (androidConfig != null) {
			aui.macros.ComposeGenerator.syncNativeBundle(androidConfig);
		};
		haxe.macro.Context.warning("[AUI] Generated Compose files in " + aui.macros.ComposeGenerator._outputDir, haxe.macro.Context.currentPos(), null);
	}

