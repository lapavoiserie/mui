					{
						var ` = 0;
						var ` = cls.fields.get();
						while (` < `.length) {
							var field = `[`];
							++ `;
							if (field.name == "body") {
								bodyExpr = field.expr();
								break;
							};
						};
					};
				};
			};
		} else {};
		aui.macros.ComposeGenerator._navRoutes = [];
		aui.macros.ComposeGenerator._nextRouteId = 0;
		aui.macros.ComposeGenerator._hasNavigation = false;
		aui.macros.ComposeGenerator._hasTabView = false;
		if (bodyExpr != null) {
			aui.macros.ComposeGenerator.scanForNavigation(bodyExpr);
		};
		var buf = new StringBuf();
		buf.add("package " + packageName + "\n\n");
		var imports = ["androidx.compose.foundation.layout.*", "androidx.compose.foundation.lazy.LazyColumn", "androidx.compose.foundation.lazy.items", "androidx.compose.foundation.rememberScrollState", "androidx.compose.foundation.verticalScroll", "androidx.compose.material.icons.Icons", "androidx.compose.material.icons.filled.*", "androidx.compose.material3.*", "androidx.compose.runtime.*", "androidx.compose.ui.Alignment", "androidx.compose.ui.Modifier", "androidx.compose.ui.unit.dp", "androidx.compose.ui.unit.sp", "androidx.compose.ui.graphics.Color", "androidx.compose.ui.graphics.vector.ImageVector", "androidx.compose.ui.text.font.FontWeight", "androidx.compose.ui.text.font.FontStyle", "androidx.compose.ui.text.style.TextAlign", "androidx.compose.ui.text.input.PasswordVisualTransformation", "androidx.compose.foundation.background", "androidx.compose.foundation.border", "androidx.compose.foundation.clickable", "androidx.compose.foundation.shape.RoundedCornerShape", "androidx.compose.foundation.shape.CircleShape", "androidx.compose.ui.draw.*"];
		if (aui.macros.ComposeGenerator._hasNavigation) {
			imports.push("androidx.navigation.compose.NavHost");
			imports.push("androidx.navigation.compose.composable");
			imports.push("androidx.navigation.compose.rememberNavController");
		};
		{
			var ` = 0;
			while (` < imports.length) {
				var imp = imports[`];
				++ `;
				buf.add("import " + imp + "\n");
			};
		};
		buf.add("\n");
		buf.add("@Composable\n");
		buf.add("fun MainScreen(app: " + aui.macros.ComposeGenerator.appJvmName() + ") {\n");
		if (aui.macros.ComposeGenerator._hasNavigation) {
			buf.add("    val navController = rememberNavController()\n\n");
		};
		if (bodyExpr != null) {
			aui.macros.ComposeGenerator._indent = 1;
			buf.add(aui.macros.ComposeGenerator.translateTypedExpr(bodyExpr));
		} else {
			buf.add("    Text(\"Hello from AUI!\")\n");
		};
		buf.add("}\n");
		sys.io.File.saveContent(aui.macros.ComposeGenerator._outputDir + "/MainScreen.kt", buf.toString());
	}

