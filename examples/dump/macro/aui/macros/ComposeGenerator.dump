	static function ensureDir(path:String) {
		if (! sys.FileSystem.exists(path)) {
			var parts = path.split("/");
			var current = "";
			{
				var ` = 0;
				while (` < parts.length) {
					var part = parts[`];
					++ `;
					current += part + "/";
					if (! sys.FileSystem.exists(current)) {
						sys.FileSystem.createDirectory(current);
					};
				};
			};
		};
	}

	static function checkDynamicCoverage(types:Array<haxe.macro.ModuleType>) {
		var covered = aui.macros.ComposeGenerator.coveredViewTypes();
		if (covered == null) {
			return;
		};
		var offenders = [];
		{
			var ` = 0;
			while (` < types.length) {
				var mt = types[`];
				++ `;
				@:ast(switch (mt) {
	case TClassDecl(ref):
		var cls = ref.get();
		if (!isAppSubclass(cls)) continue;
		for (field  in  cls.fields.get()) collectViews(field, covered, offenders);
		for (field  in  cls.statics.get()) collectViews(field, covered, offenders);	
	default:
}) if (enumIndex mt == 0) {
					var ` = mt[0];
					{
						var ref = `;
						{
							var cls = ref.get();
							if (! aui.macros.ComposeGenerator.isAppSubclass(cls)) {
								continue;
							};
							{
								var ` = 0;
								var ` = cls.fields.get();
								while (` < `.length) {
									var field = `[`];
									++ `;
									aui.macros.ComposeGenerator.collectViews(field, covered, offenders);
								};
							};
							{
								var ` = 0;
								var ` = cls.statics.get();
								while (` < `.length) {
									var field = `[`];
									++ `;
									aui.macros.ComposeGenerator.collectViews(field, covered, offenders);
								};
							};
						};
					};
				} else {};
			};
		};
		if (offenders.length == 0) {
			return;
		};
		var known = {
			var ` = [];
			for (k in covered.keys()) {
				`.push(k);
			};
			`;
		};
		known.sort(Reflect.compare);
		{
			var ` = 0;
			var ` = offenders.length;
			while (` < `) {
				var i = ` ++;
				var o = offenders[i];
				var msg = "The dynamic renderer cannot draw \"" + o.name + "\".\n" + "  Covered types: " + known.join(", ") + ".\n" + "  Add it to the when() in aui/runtime/DynamicComposable.kt.";
				if (i == offenders.length - 1) {
					haxe.macro.Context.error(msg, o.pos, null);
				} else {
					haxe.macro.Context.reportError(msg, o.pos, null);
				};
			};
		};
	}

	static function coveredViewTypes() {
		var path = aui.macros.ComposeGenerator.locateAuiRuntimeFile("DynamicComposable.kt");
		if (path == null) {
			haxe.macro.Context.error("[AUI] DynamicComposable.kt not found: cannot check what the dynamic renderer covers.", haxe.macro.Context.currentPos(), null);
			return null;
		};
		var source = sys.io.File.getContent(path);
		var from = source.indexOf("fun DynamicView(", null);
		var to = source.indexOf("fun applyModifiers(", null);
		if (from < 0 || to < 0 || to < from) {
			haxe.macro.Context.error("[AUI] DynamicComposable.kt is not in the expected shape (DynamicView then applyModifiers): the check cannot assert anything.", haxe.macro.Context.currentPos(), null);
			return null;
		};
		var out = {
			{};
			new haxe.ds.StringMap();
		};
		var branch = new EReg("^\\s*\"([A-Za-z0-9_]+)\"\\s*->", "");
		{
			var ` = 0;
			var ` = source.substring(from, to).split("\n");
			while (` < `.length) {
				var line = `[`];
				++ `;
				if (branch.match(line)) {
					{
						var key = branch.matched(1);
						out.set(key, true);
					};
				};
			};
		};
		if (! out.keys().hasNext()) {
			haxe.macro.Context.error("[AUI] No type recognised in the when() of DynamicComposable.kt: the check cannot assert anything.", haxe.macro.Context.currentPos(), null);
			return null;
		};
		return out;
	}

	static function isAppSubclass(cls:haxe.macro.ClassType) {
		var current = if (cls.superClass == null) {
			null;
		} else {
			cls.superClass.t.get();
		};
		while (current != null) {
			if (current.name == "App" && current.pack.join(".") == "aui") {
				return true;
			};
			current = if (current.superClass == null) {
				null;
			} else {
				current.superClass.t.get();
			};
		};
		return false;
	}

	static function collectViews(field:haxe.macro.ClassField, covered:Map<String, Bool>, offenders:Array<{ pos : haxe.macro.Position, name : String }>) {
		if (field.name != "body" && ! aui.macros.ComposeGenerator.buildsViews(field)) {
			return;
		};
		var e = field.expr();
		if (e != null) {
			aui.macros.ComposeGenerator.walkForViews(e, covered, offenders);
		};
	}

	static function buildsViews(field:haxe.macro.ClassField) {
		return @:ast(switch (haxe.macro.TypeTools.follow(field.type)) {
	case TFun(_, ret):
		isViewType(ret);	
	case _:
		false;	
}) {
			var ` = {
				var t = field.type;
				var once = null;
				haxe.macro.Context.follow(t, once);
			};
			if (enumIndex ` == 4) {
				var ` = `[0];
				var ` = `[1];
				{
					var ret = `;
					{
						aui.macros.ComposeGenerator.isViewType(ret);
					};
				};
			} else {
				false;
			};
		};
	}

	static function isViewType(t:haxe.macro.Type) {
		return @:ast(switch (haxe.macro.TypeTools.follow(t)) {
	case TInst(ref, _):
		var cls = ref.get();
		while (cls != null) {
			if (cls.name == "View" && cls.pack.join(".") == "aui") return true;
			cls = cls.superClass == null ? null : cls.superClass.t.get();
		};
		false;	
	case _:
		false;	
}) {
			var ` = {
				var once = null;
				haxe.macro.Context.follow(t, once);
			};
			if (enumIndex ` == 2) {
				var ` = `[0];
				var ` = `[1];
				{
					var ref = `;
					{
						var cls = ref.get();
						while (cls != null) {
							if (cls.name == "View" && cls.pack.join(".") == "aui") {
								return true;
							};
							cls = if (cls.superClass == null) {
								null;
							} else {
								cls.superClass.t.get();
							};
						};
						false;
					};
				};
			} else {
				false;
			};
		};
	}

	static function isComponentName(fullName:String) {
		try {
			@:ast(switch (Context.follow(Context.getType(fullName))) {
	case TInst(ref, _):
		return isComponent(ref.get());	
	case _:
		return false;	
}) {
				var ` = haxe.macro.Context.follow(haxe.macro.Context.getType(fullName), null);
				if (enumIndex ` == 2) {
					var ` = `[0];
					var ` = `[1];
					{
						var ref = `;
						{
							return aui.macros.ComposeGenerator.isComponent(ref.get());
						};
					};
				} else {
					return false;
				};
			};
		} catch (`:Dynamic) {
			{};
			{};
			if (true) {
				{};
				{
					return false;
				};
			} else throw `;
		};
	}

	static function coveredByChain(cls:haxe.macro.ClassType, covered:Map<String, Bool>) {
		var current = cls;
		while (current != null) {
			if ({
				var key = current.name;
				covered.exists(key);
			}) {
				return true;
			};
			current = if (current.superClass == null) {
				null;
			} else {
				current.superClass.t.get();
			};
		};
		return false;
	}

	static function isExpanded(cls:haxe.macro.ClassType) {
		if (aui.macros.ComposeGenerator.isComponent(cls)) {
			return true;
		};
		return cls.name == "ForEach" && cls.pack.join(".") == "aui.ui";
	}

	static function isComponent(cls:haxe.macro.ClassType) {
		var current = cls;
		while (current != null) {
			if (current.name == "ViewComponent" && current.pack.join(".") == "aui") {
				return true;
			};
			current = if (current.superClass == null) {
				null;
			} else {
				current.superClass.t.get();
			};
		};
		return false;
	}

	static function extendsView(cls:haxe.macro.ClassType) {
		var current = cls;
		while (current != null) {
			if (current.name == "View" && current.pack.join(".") == "aui") {
				return true;
			};
			current = if (current.superClass == null) {
				null;
			} else {
				current.superClass.t.get();
			};
		};
		return false;
	}

	static function walkForViews(e:haxe.macro.TypedExpr, covered:Map<String, Bool>, offenders:Array<{ pos : haxe.macro.Position, name : String }>) {
		if (e == null) {
			return;
		};
		@:ast(switch (e.expr) {
	case TNew(ref, _, _):
		var cls = ref.get();
		if (extendsView(cls) && !isExpanded(cls) && !coveredByChain(cls, covered)) {
			offenders.push({ name : cls.name, pos : e.pos });
		};	
	default:
}) {
			var ` = e.expr;
			if (enumIndex ` == 10) {
				var ` = `[0];
				var ` = `[1];
				var ` = `[2];
				{
					var ref = `;
					{
						var cls = ref.get();
						if (aui.macros.ComposeGenerator.extendsView(cls) && ! aui.macros.ComposeGenerator.isExpanded(cls) && ! aui.macros.ComposeGenerator.coveredByChain(cls, covered)) {
							offenders.push({name : cls.name, pos : e.pos});
						};
					};
				};
			} else {};
		};
		haxe.macro.TypedExprTools.iter(e, function(sub:haxe.macro.TypedExpr) aui.macros.ComposeGenerator.walkForViews(sub, covered, offenders));
	}
}