			var anchor = sys.FileSystem.absolutePath(haxe.macro.Context.resolvePath("aui/state/State.hx"));
			var dir = haxe.io.Path.directory(anchor);
			dir = haxe.io.Path.directory(dir);
			dir = haxe.io.Path.directory(dir);
			dir = haxe.io.Path.directory(dir);
			var candidate = dir + "/runtime/" + name;
			if (sys.FileSystem.exists(candidate)) {
				return candidate;
			};
		} catch (`:Dynamic) {
			{};
			{};
			if (true) {
				{};
				{};
			} else throw `;
		};
		return null;
	}

	static function syncNativeBundle(cfg:aui.macros.AndroidPackagingConfig) {
		var copied = 0;
		var skipped = 0;
		var missing = [];
		if (cfg.jniLibs != null) {
			{
				var ` = 0;
				var ` = Reflect.fields(cfg.jniLibs);
				while (` < `.length) {
					var abi = `[`];
					++ `;
					var libsForAbi = Reflect.field(cfg.jniLibs, abi);
					var destDir = "android/app/src/main/jniLibs/" + abi;
					aui.macros.ComposeGenerator.ensureDir(destDir);
					{
						var ` = 0;
						var ` = Reflect.fields(libsForAbi);
						while (` < `.length) {
							var destName = `[`];
							++ `;
							var srcPath = Reflect.field(libsForAbi, destName);
							if (! sys.FileSystem.exists(srcPath)) {
								missing.push("jniLibs[" + abi + "][" + destName + "] = " + srcPath);
								continue;
							};
							var dstPath = destDir + "/" + destName;
							if (aui.macros.ComposeGenerator.copyIfNewer(srcPath, dstPath)) {
								copied ++;
							} else {
								skipped ++;
							};
						};
					};
				};
			};
		};
		if (cfg.assets != null) {
			{
				var ` = 0;
				var ` = Reflect.fields(cfg.assets);
				while (` < `.length) {
					var destSub = `[`];
					++ `;
					var srcDir = Reflect.field(cfg.assets, destSub);
					if (! sys.FileSystem.exists(srcDir) || ! sys.FileSystem.isDirectory(srcDir)) {
						missing.push("assets[" + destSub + "] = " + srcDir + " (not a directory)");
						continue;
					};
					var destDir = "android/app/src/main/assets/" + destSub;
					var stats = aui.macros.ComposeGenerator.mirrorDir(srcDir, destDir);
					copied += stats.copied;
					skipped += stats.skipped;
				};
			};
		};
		if (missing.length > 0) {
			haxe.macro.Context.warning("[AUI] nativeBundle: missing sources — " + missing.join("; "), haxe.macro.Context.currentPos(), null);
		};
		if (copied > 0) {
			haxe.macro.Context.warning("[AUI] nativeBundle: " + copied + " file(s) copied, " + skipped + " up-to-date", haxe.macro.Context.currentPos(), null);
		};
	}

	static function copyIfNewer(src:String, dst:String) {
		if (! sys.FileSystem.exists(src)) {
			return false;
		};
		var srcStat = sys.FileSystem.stat(src);
		if (sys.FileSystem.exists(dst)) {
			var dstStat = sys.FileSystem.stat(dst);
			if (dstStat.size == srcStat.size && dstStat.mtime.getTime() >= srcStat.mtime.getTime()) {
				return false;
			};
		};
		sys.io.File.copy(src, dst);
		return true;
	}

	static function mirrorDir(srcDir:String, destDir:String) {
		aui.macros.ComposeGenerator.ensureDir(destDir);
		var copied = 0;
		var skipped = 0;
		{
			var ` = 0;
			var ` = sys.FileSystem.readDirectory(srcDir);
			while (` < `.length) {
				var entry = `[`];
				++ `;
				var srcPath = srcDir + "/" + entry;
				var dstPath = destDir + "/" + entry;
				if (sys.FileSystem.isDirectory(srcPath)) {
					var sub = aui.macros.ComposeGenerator.mirrorDir(srcPath, dstPath);
					copied += sub.copied;
					skipped += sub.skipped;
				} else {
					if (aui.macros.ComposeGenerator.copyIfNewer(srcPath, dstPath)) {
						copied ++;
					} else {
						skipped ++;
					};
				};
			};
		};
		return {copied : copied, skipped : skipped};
	}

	static function escapeString(s:String) {
		var r = StringTools.replace(s, "\\", "\\\\");
		r = StringTools.replace(r, "\"", "\\\"");
		r = StringTools.replace(r, "$", "\\$");
		r = StringTools.replace(r, "\n", "\\n");
		r = StringTools.replace(r, "\r", "\\r");
		r = StringTools.replace(r, "\t", "\\t");
		return r;
	}

