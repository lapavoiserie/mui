	static function tryTranslateStaticCall(func:haxe.macro.TypedExpr, args:Array<haxe.macro.TypedExpr>) {
		@:ast(switch (func.expr) {
	case TField(_, fa):
		var fieldName = getFieldName(fa);
		if (fieldName == "withState" && args.length > 0) {
			return translateTextWithState(args[0], []);
		};	
	default:
}) {
			var ` = func.expr;
			if (enumIndex ` == 4) {
				var ` = `[0];
				var ` = `[1];
				{
					var fa = `;
					{
						var fieldName = aui.macros.ComposeGenerator.getFieldName(fa);
						if (fieldName == "withState" && args.length > 0) {
							return aui.macros.ComposeGenerator.translateTextWithState(args[0], []);
						};
					};
				};
			} else {};
		};
		return null;
	}

	static function tryTranslateStaticCallWithMods(func:haxe.macro.TypedExpr, args:Array<haxe.macro.TypedExpr>, modifiers:Array<{ name : String, args : Array<haxe.macro.TypedExpr> }>) {
