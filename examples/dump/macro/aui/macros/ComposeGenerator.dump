				};
			};
			case "aui.ui.LazyColumn": {
				{
					viewCode = aui.macros.ComposeGenerator.generateLazyColumn(args, modStr, indent);
				};
			};
			case "aui.ui.NavigationLink": {
				{
					viewCode = aui.macros.ComposeGenerator.generateNavigationLink(args, modStr, indent);
				};
			};
			case "aui.ui.NavigationStack": {
				{
					viewCode = aui.macros.ComposeGenerator.generateNavigationStack(args, modStr, indent);
				};
			};
			case "aui.ui.ProgressView": {
				{
					viewCode = aui.macros.ComposeGenerator.generateProgressView(args, modStr, indent);
				};
			};
			case "aui.ui.ScrollView": {
				{
					viewCode = aui.macros.ComposeGenerator.generateScrollView(args, modStr, indent);
				};
			};
			case "aui.ui.Section": {
				{
					viewCode = aui.macros.ComposeGenerator.generateSection(args, modStr, indent);
				};
			};
			case "aui.ui.Slider": {
				{
					viewCode = aui.macros.ComposeGenerator.generateSlider(args, modStr, indent);
				};
			};
			case "aui.ui.Spacer": {
				{
					viewCode = if (modStr.length > 0) {
						indent + "Spacer(modifier = " + modStr + ")\n";
					} else {
						indent + "Spacer(modifier = Modifier.weight(1f))\n";
					};
				};
			};
			case "aui.ui.TabView": {
				{
					viewCode = aui.macros.ComposeGenerator.generateTabView(args, modStr, indent);
				};
			};
			case "aui.ui.Text": {
				{
					viewCode = aui.macros.ComposeGenerator.generateText(args, modifiers, indent);
				};
			};
			case "aui.ui.TextField": {
				{
					viewCode = aui.macros.ComposeGenerator.generateTextField(args, modStr, indent);
				};
			};
			case "aui.ui.Toggle": {
				{
					viewCode = aui.macros.ComposeGenerator.generateToggle(args, modStr, indent);
				};
			};
			case "aui.ui.VStack": {
				{
					viewCode = aui.macros.ComposeGenerator.generateContainer("Column", args, modStr, indent);
				};
			};
			case "aui.ui.ZStack": {
				{
					viewCode = aui.macros.ComposeGenerator.generateContainer("Box", args, modStr, indent);
				};
			};
			case "aui.ui.SafeArea", "mui.ui.SafeArea": {
				{
					var safeMod = if (modStr.length > 0) {
						"Modifier.safeDrawingPadding().then(" + modStr + ")";
