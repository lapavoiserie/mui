	static function writeAuiRuntimeKotlin() {
		var stateDir = "android/app/src/main/kotlin/aui/state";
		aui.macros.ComposeGenerator.ensureDir(stateDir);
		var stateBridge = aui.macros.ComposeGenerator.locateAuiRuntimeFile("StateBridge.kt");
		if (stateBridge != null) {
			aui.macros.ComposeGenerator.copyIfNewer(stateBridge, stateDir + "/StateBridge.kt");
		} else {
			haxe.macro.Context.warning("[AUI] StateBridge.kt not found in aui/runtime/ — state bridge will be missing", haxe.macro.Context.currentPos(), null);
		};
		var runtimeDir = "android/app/src/main/kotlin/aui/runtime";
		var rendererOut = runtimeDir + "/DynamicComposable.kt";
		if (aui.macros.RenderPath.isDynamic()) {
			aui.macros.ComposeGenerator.ensureDir(runtimeDir);
			var renderer = aui.macros.ComposeGenerator.locateAuiRuntimeFile("DynamicComposable.kt");
			if (renderer != null) {
				aui.macros.ComposeGenerator.copyIfNewer(renderer, rendererOut);
			} else {
				haxe.macro.Context.warning("[AUI] DynamicComposable.kt not found in aui/runtime/ — the app will not link", haxe.macro.Context.currentPos(), null);
			};
		} else {
			if (sys.FileSystem.exists(rendererOut)) {
				sys.FileSystem.deleteFile(rendererOut);
			};
		};
		var androidDir = "android/app/src/main/kotlin/aui/android";
		aui.macros.ComposeGenerator.ensureDir(androidDir);
		var androidIo = aui.macros.ComposeGenerator.locateAuiRuntimeFile("AndroidIo.kt");
		if (androidIo != null) {
			aui.macros.ComposeGenerator.copyIfNewer(androidIo, androidDir + "/AndroidIo.kt");
		};
	}

	static function locateAuiRuntimeFile(name:String) {
