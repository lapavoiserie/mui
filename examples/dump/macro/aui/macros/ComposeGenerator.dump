	static function translateTextWithState(templateExpr:haxe.macro.TypedExpr, modifiers:Array<{ name : String, args : Array<haxe.macro.TypedExpr> }>) {
		var indent = aui.macros.ComposeGenerator.getIndent();
		var template = "";
		@:ast(switch (templateExpr.expr) {
	case TConst(TString(s)):
		template = s;	
	default:
		template = translateTypedExpr(templateExpr);	
}) {
			var ` = templateExpr.expr;
			if (enumIndex ` == 0) {
				var ` = `[0];
				if (enumIndex ` == 2) {
					var ` = `[0];
					{
						var s = `;
						{
							template = s;
						};
					};
				} else {
					template = aui.macros.ComposeGenerator.translateTypedExpr(templateExpr);
				};
			} else {
				template = aui.macros.ComposeGenerator.translateTypedExpr(templateExpr);
			};
		};
		var reg = new EReg("\\{([^}]+)\\}", "g");
		var kotlinStr = reg.map(template, function(r:EReg) {
			var ref = r.matched(1);
			{
				var ` = 0;
				var ` = aui.macros.ComposeGenerator._stateFields;
				while (` < `.length) {
					var sf = `[`];
					++ `;
					if (sf.name == ref) {
						return "${" + aui.macros.ComposeGenerator.stateReadForInterp(ref) + "}";
					};
				};
			};
			return "$" + ref;
		});
		var hasBold = false;
		var hasItalic = false;
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "bold") {
					hasBold = true;
				};
				if (mod.name == "italic") {
					hasItalic = true;
				};
			};
		};
		var layoutMods = aui.macros.ComposeGenerator.buildModifierChain(modifiers);
		var buf = new StringBuf();
		buf.add(indent + "Text(\n");
		buf.add(indent + "    text = \"" + kotlinStr + "\"");
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "foregroundColor" && mod.args.length > 0) {
					buf.add(",\n" + indent + "    color = " + aui.macros.ComposeGenerator.translateColorArg(mod.args[0]));
				};
			};
		};
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "font" && mod.args.length > 0) {
					var fontInfo = aui.macros.ComposeGenerator.translateFontArg(mod.args[0]);
					if (fontInfo.style != null) {
						buf.add(",\n" + indent + "    style = " + fontInfo.style);
					};
				};
			};
		};
		if (hasBold) {
			buf.add(",\n" + indent + "    fontWeight = FontWeight.Bold");
		};
		if (hasItalic) {
			buf.add(",\n" + indent + "    fontStyle = FontStyle.Italic");
		};
		if (layoutMods.length > 0) {
			buf.add(",\n" + indent + "    modifier = " + layoutMods);
		};
		buf.add("\n" + indent + ")\n");
		return buf.toString();
	}

	static function unwrapModifierChain(expr:haxe.macro.TypedExpr, modifiers:Array<{ name : String, args : Array<haxe.macro.TypedExpr> }>) {
