	static function buildModifierChain(modifiers:Array<{ name : String, args : Array<haxe.macro.TypedExpr> }>) {
		var parts = new Array();
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				var part = aui.macros.ComposeGenerator.translateSingleModifier(mod.name, mod.args);
				if (part.length > 0) {
					parts.push(part);
				};
			};
		};
		if (parts.length == 0) {
			return "";
		};
		return "Modifier" + parts.join("");
	}

	static function translateSingleModifier(name:String, args:Array<haxe.macro.TypedExpr>) {
		@:ast(switch (name) {
