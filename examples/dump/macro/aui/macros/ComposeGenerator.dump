					viewCode = aui.macros.ComposeGenerator.generateContainer("Column", args, safeMod, indent);
				};
			};
			default: {
				if (StringTools.endsWith(fullName, "ViewComponent") || aui.macros.ComposeGenerator.isComponentName(fullName)) {
					haxe.macro.Context.error("The static path cannot render a ViewComponent (\"" + fullName + "\").\n" + "  It would need a composable of its own, carrying the component's state.\n" + "  Drop -D " + "aui_static" + " -- the dynamic renderer, which is\n" + "  the default, expands components.", haxe.macro.Context.currentPos(), null);
