				viewCode = "";
			}
		};
		return prefix + viewCode;
	}

	static function generateText(args:Array<haxe.macro.TypedExpr>, modifiers:Array<{ name : String, args : Array<haxe.macro.TypedExpr> }>, indent:String) {
		var textContent = "\"\"";
		if (args.length > 0) {
			textContent = aui.macros.ComposeGenerator.translateTypedExpr(args[0]);
		};
		var hasBold = false;
		var hasItalic = false;
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "bold") {
					hasBold = true;
				};
				if (mod.name == "italic") {
					hasItalic = true;
				};
			};
		};
		var layoutMods = aui.macros.ComposeGenerator.buildModifierChain(modifiers);
		var buf = new StringBuf();
		buf.add(indent + "Text(\n");
		buf.add(indent + "    text = " + textContent);
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "foregroundColor" && mod.args.length > 0) {
					buf.add(",\n" + indent + "    color = " + aui.macros.ComposeGenerator.translateColorArg(mod.args[0]));
				};
			};
		};
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "font" && mod.args.length > 0) {
					var fontInfo = aui.macros.ComposeGenerator.translateFontArg(mod.args[0]);
					if (fontInfo.style != null) {
						buf.add(",\n" + indent + "    style = " + fontInfo.style);
					};
				};
			};
		};
		if (hasBold) {
			buf.add(",\n" + indent + "    fontWeight = FontWeight.Bold");
		};
		if (hasItalic) {
			buf.add(",\n" + indent + "    fontStyle = FontStyle.Italic");
		};
		{
			var ` = 0;
			while (` < modifiers.length) {
				var mod = modifiers[`];
				++ `;
				if (mod.name == "multilineTextAlignment" && mod.args.length > 0) {
					buf.add(",\n" + indent + "    textAlign = " + aui.macros.ComposeGenerator.translateTextAlignArg(mod.args[0]));
				};
			};
		};
		if (layoutMods.length > 0) {
			buf.add(",\n" + indent + "    modifier = " + layoutMods);
		};
		buf.add("\n" + indent + ")\n");
		return buf.toString();
	}

	static function generateContainer(composeName:String, args:Array<haxe.macro.TypedExpr>, modStr:String, indent:String) {
		var buf = new StringBuf();
		var contentArg = null;
		var spacingArg = null;
		{
			var ` = 0;
			while (` < args.length) {
				var arg = args[`];
				++ `;
				@:ast(switch (arg.expr) {
	case TArrayDecl(_):
		contentArg = arg;	
	case TConst(TInt(_)), TConst(TFloat(_)):
		spacingArg = arg;	
	default:
}) {
					var ` = arg.expr;
					switch (enumIndex `) {
						case 0: {
							var ` = `[0];
							switch (enumIndex `) {
								case 0: {
									var ` = `[0];
									{
										spacingArg = arg;
									};
								};
								case 1: {
									var ` = `[0];
									{
										spacingArg = arg;
									};
								};
								default: {}
							};
						};
						case 8: {
							var ` = `[0];
							{
								contentArg = arg;
							};
						};
						default: {}
					};
				};
			};
		};
		var params = new Array();
		if (modStr.length > 0) {
			params.push("modifier = " + modStr);
		};
		if (composeName == "Column") {
			params.push("horizontalAlignment = Alignment.CenterHorizontally");
		} else {
			if (composeName == "Row") {
				params.push("verticalAlignment = Alignment.CenterVertically");
				if (spacingArg != null) {
					params.push("horizontalArrangement = Arrangement.spacedBy(" + aui.macros.ComposeGenerator.translateTypedExpr(spacingArg) + ".dp)");
				};
			};
		};
		if (params.length > 0) {
			buf.add(indent + composeName + "(\n");
			{
				var ` = 0;
				var ` = params.length;
				while (` < `) {
					var i = ` ++;
					buf.add(indent + "    " + params[i]);
					if (i < params.length - 1) {
						buf.add(",");
					};
					buf.add("\n");
				};
			};
			buf.add(indent + ") {\n");
		} else {
			buf.add(indent + composeName + " {\n");
		};
		if (contentArg != null) {
			@:ast(switch (contentArg.expr) {
	case TArrayDecl(elements):
		_indent++;
		for (element  in  elements) buf.add(translateTypedExpr(element));
		_indent--;	
	default:
}) {
				var ` = contentArg.expr;
				if (enumIndex ` == 8) {
					var ` = `[0];
					{
						var elements = `;
						{
							aui.macros.ComposeGenerator._indent ++;
							{
								var ` = 0;
								while (` < elements.length) {
									var element = elements[`];
									++ `;
									buf.add(aui.macros.ComposeGenerator.translateTypedExpr(element));
								};
							};
							aui.macros.ComposeGenerator._indent --;
						};
					};
				} else {};
			};
		};
		buf.add(indent + "}\n");
		return buf.toString();
	}

	static function generateButton(args:Array<haxe.macro.TypedExpr>, modStr:String, indent:String) {
		var buf = new StringBuf();
		var label = "\"\"";
		if (args.length > 0) {
			label = aui.macros.ComposeGenerator.translateTypedExpr(args[0]);
		};
		var actionCode = "{ }";
		if (args.length >= 2) {
			var sa = aui.macros.ComposeGenerator.translateStateAction(args[1]);
			if (sa != null) {
				actionCode = "{ " + sa + " }";
			} else {
				var mref = aui.macros.ComposeGenerator.translateMethodRef(args[1]);
				if (mref != null) {
					actionCode = "{ " + mref + " }";
				};
			};
		};
		buf.add(indent + "Button(\n");
		buf.add(indent + "    onClick = " + actionCode);
		if (modStr.length > 0) {
			buf.add(",\n" + indent + "    modifier = " + modStr);
		};
		buf.add("\n" + indent + ") {\n");
		buf.add(indent + "    Text(" + label + ")\n");
		buf.add(indent + "}\n");
		return buf.toString();
	}

	static function translateMethodRef(expr:haxe.macro.TypedExpr) {
		if (expr == null) {
			return null;
		};
		@:ast(switch (expr.expr) {
	case TField(_, fa):
		switch (fa) {
			case FInstance(_, _, ref):
				var f = ref.get();
				switch (f.type) {
					case TFun(_, _):
						return "app." + f.name + "()";					
					default:
				};			
			case FClosure(_, ref):
				var f = ref.get();
				switch (f.type) {
					case TFun(_, _):
						return "app." + f.name + "()";					
					default:
				};			
			default:
		};	
	case TParenthesis(e):
		return translateMethodRef(e);	
	case TMeta(_, e):
		return translateMethodRef(e);	
	case TCast(e, _):
		return translateMethodRef(e);	
	default:
}) {
			var ` = expr.expr;
			switch (enumIndex `) {
				case 4: {
					var ` = `[0];
					var ` = `[1];
					{
						var fa = `;
						{
							@:ast(switch (fa) {
	case FInstance(_, _, ref):
		var f = ref.get();
		switch (f.type) {
			case TFun(_, _):
				return "app." + f.name + "()";			
			default:
		};	
	case FClosure(_, ref):
		var f = ref.get();
		switch (f.type) {
			case TFun(_, _):
				return "app." + f.name + "()";			
			default:
		};	
	default:
}) switch (enumIndex fa) {
								case 0: {
									var ` = fa[0];
									var ` = fa[1];
									var ` = fa[2];
									{
										var ref = `;
										{
											var f = ref.get();
											@:ast(switch (f.type) {
	case TFun(_, _):
		return "app." + f.name + "()";	
	default:
}) {
												var ` = f.type;
												if (enumIndex ` == 4) {
													var ` = `[0];
													var ` = `[1];
													{
														return "app." + f.name + "()";
													};
												} else {};
											};
										};
									};
								};
								case 4: {
									var ` = fa[0];
									var ` = fa[1];
									{
										var ref = `;
										{
											var f = ref.get();
											@:ast(switch (f.type) {
	case TFun(_, _):
		return "app." + f.name + "()";	
	default:
}) {
												var ` = f.type;
												if (enumIndex ` == 4) {
													var ` = `[0];
													var ` = `[1];
													{
														return "app." + f.name + "()";
													};
												} else {};
											};
										};
									};
								};
								default: {}
							};
						};
					};
				};
				case 6: {
					var ` = `[0];
					{
						var e = `;
						{
							return aui.macros.ComposeGenerator.translateMethodRef(e);
						};
					};
				};
				case 24: {
					var ` = `[0];
					var ` = `[1];
					{
						var e = `;
						{
							return aui.macros.ComposeGenerator.translateMethodRef(e);
						};
					};
				};
				case 25: {
					var ` = `[0];
					var ` = `[1];
					{
						var e = `;
						{
							return aui.macros.ComposeGenerator.translateMethodRef(e);
						};
					};
				};
				default: {}
			};
		};
		return null;
	}

	static function generateTextField(args:Array<haxe.macro.TypedExpr>, modStr:String, indent:String) {
		var buf = new StringBuf();
		var placeholder = "\"\"";
		if (args.length > 0) {
			placeholder = aui.macros.ComposeGenerator.translateTypedExpr(args[0]);
		};
		var stateName = null;
		if (args.length >= 2) {
			stateName = aui.macros.ComposeGenerator.extractStateFieldName(args[1]);
		};
		if (stateName != null) {
			buf.add(indent + "OutlinedTextField(\n");
			buf.add(indent + "    value = " + aui.macros.ComposeGenerator.stateRead(stateName) + ",\n");
			buf.add(indent + "    onValueChange = { " + aui.macros.ComposeGenerator.stateAssign(stateName, "it") + " },\n");
			buf.add(indent + "    label = { Text(" + placeholder + ") }");
			if (modStr.length > 0) {
				buf.add(",\n" + indent + "    modifier = " + modStr);
			} else {
				buf.add(",\n" + indent + "    modifier = Modifier.fillMaxWidth()");
			};
			buf.add("\n" + indent + ")\n");
		} else {
			buf.add(indent + "OutlinedTextField(\n");
			buf.add(indent + "    value = \"\",\n");
			buf.add(indent + "    onValueChange = { },\n");
			buf.add(indent + "    label = { Text(" + placeholder + ") }");
			if (modStr.length > 0) {
				buf.add(",\n" + indent + "    modifier = " + modStr);
			};
			buf.add("\n" + indent + ")\n");
		};
		return buf.toString();
	}

	static function generateToggle(args:Array<haxe.macro.TypedExpr>, modStr:String, indent:String) {
		var buf = new StringBuf();
		var label = "\"\"";
		if (args.length > 0) {
			label = aui.macros.ComposeGenerator.translateTypedExpr(args[0]);
		};
		var stateName = null;
		if (args.length >= 2) {
			stateName = aui.macros.ComposeGenerator.extractStateFieldName(args[1]);
		};
		buf.add(indent + "Row(\n");
		buf.add(indent + "    verticalAlignment = Alignment.CenterVertically");
		if (modStr.length > 0) {
			buf.add(",\n" + indent + "    modifier = " + modStr);
		} else {
			buf.add(",\n" + indent + "    modifier = Modifier.fillMaxWidth()");
		};
		buf.add("\n" + indent + ") {\n");
		buf.add(indent + "    Text(text = " + label + ", modifier = Modifier.weight(1f))\n");
		if (stateName != null) {
			buf.add(indent + "    Switch(checked = " + aui.macros.ComposeGenerator.stateRead(stateName) + ", onCheckedChange = { " + aui.macros.ComposeGenerator.stateAssign(stateName, "it") + " })\n");
		} else {
			buf.add(indent + "    Switch(checked = false, onCheckedChange = { })\n");
		};
		buf.add(indent + "}\n");
		return buf.toString();
	}

	static function generateSlider(args:Array<haxe.macro.TypedExpr>, modStr:String, indent:String) {
		var indent2 = indent;
		var buf = new StringBuf();
		var stateName = null;
		if (args.length >= 1) {
			stateName = aui.macros.ComposeGenerator.extractStateFieldName(args[0]);
		};
		var mod = if (modStr.length > 0) {
			modStr;
		} else {
			"Modifier.fillMaxWidth()";
		};
		if (stateName != null) {
			buf.add(indent + "Slider(\n");
			buf.add(indent + "    value = " + aui.macros.ComposeGenerator.stateRead(stateName) + ".toFloat(),\n");
			buf.add(indent + "    onValueChange = { " + aui.macros.ComposeGenerator.stateAssign(stateName, "it") + " },\n");
			buf.add(indent + "    modifier = " + mod + "\n");
			buf.add(indent + ")\n");
		} else {
			buf.add(indent + "Slider(\n");
			buf.add(indent + "    value = 0f,\n");
			buf.add(indent + "    onValueChange = { },\n");
			buf.add(indent + "    modifier = " + mod + "\n");
			buf.add(indent + ")\n");
		};
		return buf.toString();
	}

	static function generateScrollView(args:Array<haxe.macro.TypedExpr>, modStr:String, indent:String) {
		var buf = new StringBuf();
		var mod = if (modStr.length > 0) {
			modStr + ".verticalScroll(rememberScrollState())";
		} else {
			"Modifier.fillMaxSize().verticalScroll(rememberScrollState())";
		};
		buf.add(indent + "Column(\n");
		buf.add(indent + "    modifier = " + mod + "\n");
		buf.add(indent + ") {\n");
		{
			var ` = 0;
			while (` < args.length) {
