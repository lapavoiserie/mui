	static function checkHosted(parsed:mui.macros.Parsed, methodName:String, pos:haxe.macro.Position) {
		if (parsed.optional) {
			return;
		};
		var hosted = mui.macros.Surfaces.hostedRoles();
		var backend = if (haxe.macro.Context.defined("mui_backend")) {
			haxe.macro.Context.definedValue("mui_backend");
		} else {
			"this backend";
		};
		if (hosted == null) {
			haxe.macro.Context.warning("" + backend + " states no @:hostedRoles on its mui.App, so surface " + "declarations cannot be checked against it.", pos, null);
			return;
		};
		if (parsed.role == "Companion" && ! haxe.macro.Context.defined("mui_cafos")) {
			haxe.macro.Context.error("a Companion surface is served over the network by cafos, which is off in " + "this build: \"" + parsed.id + "\" would be declared but never reachable.\n" + "  Turn it on for this build with -D " + "mui_cafos" + " (and cafos on the classpath), " + "or mark the declaration optional.", pos, null);
			return;
		};
		if (hosted.contains(parsed.role)) {
			return;
		};
		haxe.macro.Context.error("" + backend + " hosts no " + parsed.role + ": surface \"" + parsed.id + "\" would fly nowhere here" + (if (hosted.length == 0) {
			" (it hosts no declared surface at all)";
		} else {
			" (it hosts " + hosted.join(", ") + ")";
		}) + ". Accept that with @:surface(" + parsed.role + ", optional), or build for a backend that hosts it.", pos, null);
	}

