class aui.ui.HStack extends aui.View {

	public function new(alignment:Null<aui.ui.VerticalAlignment> = null, spacing:Null<Float> = null, content:Array<aui.View>) {
		super();
		this.viewType = "HStack";
		this.alignment = if ((alignment != null)) alignment else aui.ui.VerticalAlignment.Center;
		this.spacing = spacing;
		this.children = content;
	}

	public var spacing:Null<Float>;

	public var alignment:aui.ui.VerticalAlignment;
}