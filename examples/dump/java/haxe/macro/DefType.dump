typedef haxe.macro.DefType = { type : haxe.macro.Type, pos : haxe.macro.Position, params : Array<haxe.macro.TypeParameter>, pack : Array<java.lang.String>, name : java.lang.String, module : java.lang.String, meta : haxe.macro.MetaAccess, isPrivate : Bool, isExtern : Bool, exclude : () -> Void, doc : Null<java.lang.String> }